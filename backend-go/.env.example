# 飞光 Lumifly 后端配置
PORT=8004
SECRET_KEY=please-change-me-to-a-random-secret

# 数据库与上传目录
DATABASE_PATH=./data/lumifly.db
UPLOAD_DIR=./uploads

# 旧版 life-recorder 数据迁移（首次启动自动复制，可留空跳过）
LEGACY_DB_PATH=
LEGACY_UPLOADS_DIR=

# 管理员邮箱（逗号分隔，例如 a@x.com,b@x.com）。留空则无内置管理员。
ADMIN_EMAILS=

# 前端访问地址（用于邮件里的找回密码链接）
APP_BASE_URL=http://localhost:5176

# 邮件服务（SMTP）。未配置时「邮箱找回」进入开发模式：不真实发信，接口直接返回重置链接。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=飞光 Lumifly
